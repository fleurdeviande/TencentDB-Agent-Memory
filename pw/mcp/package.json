{
  "name": "@pw/memory-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "One stdio MCP server for Claude Code: TencentDB Agent Memory tools (#1268 plugin) plus the MemoryKnowledge code_* / wiki_* tools, and the plugin's recall/capture hooks.",
  "type": "module",
  "bin": {
    "pw-memory": "./dist/cli.js",
    "pw-memory-mcp": "./dist/server.js"
  },
  "scripts": {
